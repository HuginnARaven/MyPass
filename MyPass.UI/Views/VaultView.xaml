<UserControl x:Class="MyPass.UI.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MyPass.UI.ViewModels"
             xmlns:models="clr-namespace:MyPass.Core.Models;assembly=MyPass.Core"
             d:DataContext="{d:DesignInstance vm:VaultViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldLock24"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Margin="0,0,10,0" />
                    <ui:TextBlock Text="MyPass Vault"
                                  FontTypography="Subtitle"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status Message -->
                <ui:TextBlock Grid.Column="1"
                              Text="{Binding StatusMessage}"
                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                              FontTypography="Caption"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              Margin="16,0" />

                <!-- Top Bar Actions: Export Backup & Lock Vault -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowExportUp24}"
                               Content="Export Backup"
                               Command="{Binding ExportVaultCommand}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />

                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon LockClosed24}"
                               Content="Lock Vault"
                               Command="{Binding LockVaultCommand}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Master List -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Box & Add New Button -->
                    <StackPanel Grid.Row="0" Margin="12,12,12,8">
                        <ui:TextBox PlaceholderText="Search..."
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    ClearButtonEnabled="True"
                                    Margin="0,0,0,8" />

                        <ui:Button Appearance="Primary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Content="Add new password"
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding StartNewEntryCommand}" />
                    </StackPanel>

                    <!-- ListBox of Entries -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredEntries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PasswordEntry}">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Key24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Title}"
                                                      FontTypography="BodyStrong"
                                                      TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty List Hint -->
                    <ui:TextBlock Grid.Row="1"
                                  Text="No entries found"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding HasNoFilteredEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Footer Total Count -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <ui:TextBlock Text="{Binding EntryCountText}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      FontSize="11"
                                      HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Detail / Editor -->
            <Grid Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                <!-- Placeholder when no item is selected and not creating -->
                <Grid Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="320">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24"
                                       FontSize="56"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16" />
                        <ui:TextBlock Text="Select an entry or create a new one"
                                      FontTypography="Subtitle"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,16" />
                        <ui:Button Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Content="Add New Entry"
                                   HorizontalAlignment="Center"
                                   Command="{Binding StartNewEntryCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Detail Editor Form inside ScrollViewer and Card -->
                <ScrollViewer Visibility="{Binding IsEditingOrCreating, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24">
                    <ui:Card Padding="24" MaxWidth="620" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <!-- Form Header -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding DetailHeader}"
                                                  FontTypography="Subtitle" />
                                    <ui:TextBlock Text="Manage credentials securely with authenticated AES-GCM encryption."
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Title Field -->
                            <ui:TextBlock Text="Title"
                                          FontTypography="BodyStrong"
                                          Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Service Name (e.g., GitHub, Gmail)"
                                        Margin="0,0,0,16" />

                            <!-- Login Field with Copy button -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                              Text="Login"
                                              FontTypography="BodyStrong"
                                              VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1"
                                           Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           ToolTip="Copy login to clipboard (auto-clears in 15s)"
                                           Command="{Binding CopyLoginCommand}"
                                           Padding="6,2" />
                            </Grid>
                            <ui:TextBox Text="{Binding EditLogin, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Username or Email (optional)"
                                        Margin="0,0,0,16" />

                            <!-- Password Field with Reveal Toggle, Copy, and Generate -->
                            <ui:TextBlock Text="Password"
                                          FontTypography="BodyStrong"
                                          Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Masked PasswordBox — named for code-behind wiring (see VaultView.xaml.cs).
                                     No Password binding here; the code-behind handles UI↔VM sync reliably. -->
                                <ui:PasswordBox x:Name="EditPasswordBox"
                                                Grid.Column="0"
                                                PlaceholderText="Password (required)"
                                                Visibility="{Binding IsPasswordMasked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Revealed Plaintext TextBox -->
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Password (required)"
                                            Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Reveal/Hide Toggle Button -->
                                <ui:Button Grid.Column="1"
                                           Margin="6,0,0,0"
                                           Appearance="Secondary"
                                           ToolTip="Toggle password visibility"
                                           Command="{Binding TogglePasswordVisibilityCommand}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Eye24"
                                                       Visibility="{Binding IsPasswordMasked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:SymbolIcon Symbol="EyeOff24"
                                                       Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </ui:Button>

                                <!-- Copy Password Button -->
                                <ui:Button Grid.Column="2"
                                           Margin="6,0,0,0"
                                           Appearance="Secondary"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           ToolTip="Copy password to clipboard (auto-clears in 15s)"
                                           Command="{Binding CopyPasswordCommand}" />

                                <!-- Generate Password Button -->
                                <ui:Button Grid.Column="3"
                                           Margin="6,0,0,0"
                                           Appearance="Secondary"
                                           Icon="{ui:SymbolIcon Sparkle24}"
                                           Content="Generate"
                                           ToolTip="Generate secure 20-character password"
                                           Command="{Binding GenerateRandomPasswordCommand}" />
                            </Grid>

                            <!-- Notes Field -->
                            <ui:TextBlock Text="Notes"
                                          FontTypography="BodyStrong"
                                          Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="80"
                                        PlaceholderText="Notes (optional)"
                                        Margin="0,0,0,24" />

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Content="Save"
                                           Width="110"
                                           Command="{Binding SaveEntryCommand}" />

                                <ui:Button Grid.Column="2"
                                           Appearance="Danger"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Content="{Binding DeleteButtonText}"
                                           Width="110"
                                           Command="{Binding DeleteEntryCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
