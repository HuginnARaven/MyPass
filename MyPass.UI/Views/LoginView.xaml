<UserControl x:Class="MyPass.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MyPass.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <ui:Card Width="420" Padding="28">
            <StackPanel>
                <!-- Lock Icon -->
                <ui:SymbolIcon Symbol="ShieldLock24"
                               FontSize="44"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                <!-- Title & Description -->
                <ui:TextBlock Text="{Binding TitleText}"
                              FontTypography="Title"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,6" />

                <ui:TextBlock Text="{Binding SubtitleText}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              TextAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16" />

                <!-- Database File Selection Bar -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Database24"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                        <ui:TextBlock Grid.Column="1"
                                      Text="{Binding CurrentDbPath}"
                                      ToolTip="{Binding CurrentDbPath}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextTrimming="CharacterEllipsis"
                                      VerticalAlignment="Center"
                                      FontSize="12" />

                        <ui:Button Grid.Column="2"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Appearance="Transparent"
                                   Padding="6,4"
                                   ToolTip="Switch or Create Database"
                                   Command="{Binding SelectDatabaseFileCommand}"
                                   Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- Master Password Input — named so code-behind can wire PasswordChanged -->
                <ui:PasswordBox x:Name="MasterPasswordBox"
                                PlaceholderText="Master Password"
                                Margin="0,0,0,12" />

                <!-- Confirm Password Input (Create Mode Only) — named for code-behind wiring -->
                <ui:PasswordBox x:Name="ConfirmPasswordBox"
                                PlaceholderText="Confirm Master Password"
                                Margin="0,0,0,12"
                                Visibility="{Binding ShowConfirmPassword, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Error Message Display -->
                <ui:TextBlock Text="{Binding ErrorMessage}"
                              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                              TextWrapping="Wrap"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,12"
                              Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Action Button & Loading Indicator -->
                <Grid Margin="0,4,0,0">
                    <ui:Button Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Content="{Binding ActionButtonText}"
                               Command="{Binding UnlockOrCreateCommand}"
                               IsEnabled="{Binding IsNotBusy}"
                               IsDefault="True" />

                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Margin="0,0,12,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
